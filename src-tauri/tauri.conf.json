{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nutcracker",
  "version": "0.1.0",
  "identifier": "com.milong.nutcracker",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nutcracker",
        "width": 1100,
